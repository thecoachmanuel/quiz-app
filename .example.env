# Frontend Base URL (Your Vercel deployment URL or custom domain)
NEXT_PUBLIC_BASE_URL=https://quiz-app-thecoachmanuel.vercel.app

# Backend API Base URL (Your Next.js app or custom backend API endpoint)
NEXT_PUBLIC_API_BASE_URL=https://quiz-app-thecoachmanuel.vercel.app

# API Version Path (default: /api/v1)
NEXT_PUBLIC_API_VERSION_PATH=/api/v1

# Authentication Token Names for Cookies & LocalStorage
NEXT_PUBLIC_TOKEN_NAME=quiz_auth_token
NEXT_PUBLIC_ADMIN_TOKEN_NAME=quiz_admin_token
